{
  "_instrucciones": [
    "Copia este archivo y renombralo a appsettings.Development.json",
    "Cambia NOMBRE_DE_TU_SERVIDOR por el nombre de tu instancia de SQL Server",
    "(lo ves en la barra de titulo de SSMS al conectarte, por ejemplo DESKTOP-ABC123)",
    "Ese archivo esta en .gitignore, asi que no se sube al repositorio.",
    "Las API Keys NO van aqui: se configuran con dotnet user-secrets (ver README)."
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "SacorDb": "Server=NOMBRE_DE_TU_SERVIDOR;Database=sacor;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=True"
  },
  "Seguridad": {
    "OrigenesPermitidos": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://localhost:3000"
    ]
  }
}
